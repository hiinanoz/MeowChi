    "save.error.message": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein neues Spiel hat begonnen. Dein alter Spielstand liegt sicher auf diesem Gerät, und wir helfen dir, ihn zurückzuholen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A fresh game has started. Your old save is kept safely on this device, and we can help you get it back."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ha empezado una partida nueva. Tu partida anterior sigue guardada en este dispositivo y podemos ayudarte a recuperarla."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une nouvelle partie a commencé. Ton ancienne sauvegarde est conservée en sécurité sur cet appareil, et nous pouvons t'aider à la récupérer."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "新しいゲームを始めました。前のセーブデータはこの端末に安全に保存されています。復元のお手伝いができます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "새 게임이 시작되었어요. 예전 저장 데이터는 이 기기에 안전하게 보관되어 있고, 되찾을 수 있게 도와드릴게요."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yeni bir oyun başladı. Eski kaydın bu cihazda güvende duruyor; geri getirmene yardım edebiliriz."
          }
        }
      }
    },
    "save.error.title": {
      "extractionState": "manual",
      "localizations": {
        "de": {
