    "game.garden.hint": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tippe auf den Weg, um zu gehen. Tippe auf ein Funkeln, um eine Überraschung auszugraben!"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tap the path to walk. Tap a sparkle to dig up a surprise!"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca el camino para andar. ¡Toca un destello para desenterrar una sorpresa!"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Touche le chemin pour avancer. Touche une étincelle pour déterrer une surprise !"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "小道をタップして歩こう。キラキラをタップするとおたからが出てくるよ！"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "길을 탭해서 걸어요. 반짝이는 곳을 탭하면 깜짝 선물이 나와요!"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yürümek için patikaya dokun. Sürprizi kazmak için parıltıya dokun!"
          }
