    "game.yarnBall.hint": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wische über das Wollknäuel, um es zu werfen. Wenn es langsamer wird, kann deine Katze es fangen. Dann wirf es wieder!"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Swipe the yarn ball to toss it. When it slows down, your cat can catch it. Then toss it again!"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Desliza el ovillo para lanzarlo. Cuando vaya más despacio, tu gato podrá atraparlo. ¡Luego lánzalo otra vez!"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fais glisser la pelote pour la lancer. Quand elle ralentit, ton chat peut l'attraper. Puis relance-la !"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "毛糸玉をスワイプして転がそう。ゆっくりになったら、ねこがキャッチできるよ。そしたらまた転がしてね！"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "털실 뭉치를 쓸어서 던져요. 느려지면 고양이가 잡을 수 있어요. 그다음 다시 던져 주세요!"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fırlatmak için yün yumağını kaydır. Yavaşlayınca kedin yakalayabilir. Sonra yeniden fırlat!"
          }
        }
      }
    },
