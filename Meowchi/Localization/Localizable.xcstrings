    "game.laserChase.hint": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zieh mit dem Finger, um den Laser zu bewegen. Jedes Mal, wenn deine Katze ihn fängt, zieh ihn wieder weg!"
          }
