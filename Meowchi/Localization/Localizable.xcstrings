    "game.toyMouse.hint": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Aufziehmaus flitzt von allein herum. Tippe auf den Boden, um deine Katze hinterherzuschicken!"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The wind-up mouse runs around on its own. Tap the floor to send your cat after it!"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El ratón de cuerda corre solo por ahí. ¡Toca el suelo para mandar a tu gato tras él!"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La souris mécanique court toute seule. Touche le sol pour envoyer ton chat à sa poursuite !"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
