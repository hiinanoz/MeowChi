    "tip.nails": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tippe jede Kralle einmal an. Krallen wachsen in ein paar Tagen nach."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tap each claw once. Nails grow back in a few days."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca cada uña una vez. Las uñas vuelven a crecer en unos días."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Touche chaque griffe une fois. Les griffes repoussent en quelques jours."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "つめを1回ずつタップしてね。つめは数日でまたのびるよ。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "발톱을 한 번씩 탭하세요. 발톱은 며칠 지나면 다시 자라요."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Her tırnağa bir kez dokun. Tırnaklar birkaç günde yeniden uzar."
          }
        }
      }
    },
    "tip.tv": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Katze liebt Fernsehen. Komm später für die nächste Sendung wieder."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your cat loves TV. Come back in a while for another show."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "A tu gato le encanta la tele. Vuelve en un rato para otro programa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ton chat adore la télé. Reviens dans un moment pour une autre émission."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ねこはテレビが大好き。しばらくしたら次の番組を見に来てね。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "고양이는 TV를 정말 좋아해요. 조금 뒤에 다음 프로그램을 보러 오세요."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kedin televizyona bayılır. Yeni bir program için biraz sonra gel."
          }
        }
      }
    },
    "tip.walk": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tippe auf den Weg, um zu gehen. Unter dem Funkeln stecken Münzen und Snacks."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tap the path to walk. Sparkles hide coins and snacks."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca el camino para andar. Los destellos esconden monedas y chuches."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Touche le chemin pour avancer. Les étincelles cachent des pièces et des friandises."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "小道をタップして歩こう。キラキラの下にはコインやおやつがかくれているよ。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "길을 탭해서 걸어요. 반짝이는 곳에 코인과 간식이 숨어 있어요."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yürümek için patikaya dokun. Parıltıların altında altın ve atıştırmalık var."
          }
        }
      }
    },
