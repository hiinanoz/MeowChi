    "reminders.ask": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Möchtest du eine sanfte Erinnerung, wenn deine Katze dich braucht?"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Want a gentle reminder when your cat needs you?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Quieres un recordatorio amable cuando tu gato te necesite?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Veux-tu un petit rappel quand ton chat a besoin de toi ?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ねこがあなたを必要としているとき、やさしくお知らせしましょうか？"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "고양이가 집사를 찾을 때 다정하게 알려 드릴까요?"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kedinin sana ihtiyacı olduğunda nazik bir hatırlatma ister misin?"
          }
        }
      }
    },
    "reminders.explain": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Höchstens eine am Tag, nur wenn deine Katze Pflege brauchen könnte, und nie nachts."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "At most one a day, only when your cat could use some care, and never at night."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Como mucho uno al día, solo cuando tu gato necesite cuidados y nunca de noche."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un par jour au maximum, seulement quand ton chat a besoin de soins, et jamais la nuit."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "1日に1回まで、お世話が必要なときだけ。夜にはお知らせしません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "하루에 한 번까지, 돌봄이 필요할 때만, 밤에는 절대 보내지 않아요."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Günde en fazla bir kez, yalnızca kedinin bakıma ihtiyacı olduğunda ve asla gece değil."
          }
        }
      }
    },
