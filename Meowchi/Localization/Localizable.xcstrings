    "onboarding.welcome.body": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein winziges Kätzchen sucht ein gemütliches Zuhause. Kümmerst du dich darum?"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A tiny kitten is looking for a cozy home. Will you take care of it?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un gatito diminuto busca un hogar acogedor. ¿Cuidarás de él?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un tout petit chaton cherche un foyer douillet. Veux-tu t'occuper de lui ?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ちいさな子ねこが、あたたかいおうちを探しています。お世話してくれる？"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "작은 아기 고양이가 따뜻한 집을 찾고 있어요. 돌봐 줄래요?"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Minik bir yavru kedi sıcak bir yuva arıyor. Ona bakar mısın?"
          }
        }
      }
    },
