    "tip.collection": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Abzeichen schalten sich beim Spielen von selbst frei. Fotos kommen von der Kamera im Zimmer."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Badges unlock on their own as you play. Photos come from the camera in the room."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las insignias se desbloquean solas mientras juegas. Las fotos salen de la cámara de la habitación."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les badges se débloquent tout seuls en jouant. Les photos viennent de l'appareil photo dans la pièce."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "バッジはあそんでいると自然にもらえるよ。写真は部屋のカメラで撮れるよ。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "배지는 플레이하다 보면 저절로 열려요. 사진은 방에 있는 카메라로 찍어요."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Oynadıkça rozetler kendiliğinden açılır. Fotoğraflar odadaki kameradan gelir."
          }
        }
      }
    },
    "tip.cozy": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Streiche langsam über deine Katze. Jeder lange Strich zählt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Stroke slowly across your cat. Each long stroke counts."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Acaricia despacio a tu gato. Cada caricia larga cuenta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Caresse ton chat lentement. Chaque longue caresse compte."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ねこをゆっくりなでてね。長くなでるほどカウントされるよ。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "고양이를 천천히 쓰다듬어 주세요. 길게 쓰다듬을 때마다 카운트돼요."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kedinin üzerinde parmağını yavaşça gezdir. Her uzun okşama sayılır."
          }
        }
      }
    },
    "tip.decor": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wähle eine Gruppe, dann einen Platz. Kostenlose Artikel gehören dir immer."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pick a group, then a slot. Free items are always yours."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige un grupo y luego un hueco. Los artículos gratis siempre son tuyos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisis un groupe, puis un emplacement. Les articles gratuits sont toujours à toi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "グループを選んで、場所を選ぼう。無料のアイテムはいつでも使えるよ。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "그룹을 고르고 자리를 골라요. 무료 아이템은 언제나 내 거예요."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Önce bir grup, sonra bir yer seç. Ücretsiz ürünler hep senin."
          }
        }
      }
    },
