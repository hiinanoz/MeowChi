    "a11y.room.hint": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wische nach oben oder unten für Aktionen, zum Beispiel Streicheln."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Swipe up or down for actions, like petting your cat."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Desliza hacia arriba o abajo para ver acciones, como acariciar a tu gato."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Balaie vers le haut ou le bas pour les actions, comme caresser ton chat."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "上下にスワイプすると、なでるなどの操作ができます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "위아래로 쓸어 넘기면 쓰다듬기 같은 동작을 할 수 있어요."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kedini sevmek gibi eylemler için yukarı veya aşağı kaydır."
          }
        }
      }
    },
